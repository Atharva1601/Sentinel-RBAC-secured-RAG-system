# ── API Keys ────────────────────────────────────
HF_API_TOKEN=your_huggingface_api_token_here
GROQ_API_KEY=your_groq_api_key_here

# ── Qdrant Vector Database ──────────────────────
# Set QDRANT_USE_CLOUD=True to use Qdrant Cloud, or False for local persistence
QDRANT_USE_CLOUD=False
QDRANT_LOCAL_URL=data/qdrant_db
QDRANT_CLOUD_URL=https://your-cluster-url.cloud.qdrant.io:6333
QDRANT_CLOUD_API_KEY=your_qdrant_cloud_api_key_here

# ── Redis Caching ───────────────────────────────
# Optional: Provide a Redis URL (e.g. from Upstash) to enable response caching
REDIS_URL=rediss://default:your_password@your-redis-instance.upstash.io:6379
